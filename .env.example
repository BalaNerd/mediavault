# ==============================================================================
# MediaVault Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development, or add these variables in
# your hosting dashboard (e.g., Netlify for frontend, Railway/Render for worker).

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Set in Netlify Dashboard)
# ------------------------------------------------------------------------------
# Base URL of the deployed Next.js web application
NEXT_PUBLIC_APP_URL=https://your-mediavault-app.netlify.app

# Remote Download Worker URL (Leave blank to use Local Mode during dev)
# Example: https://worker.yourdomain.com (Do not include trailing slash)
MEDIAVAULT_WORKER_URL=

# Shared Secret Bearer Token for Worker Authentication
# Must match the MEDIAVAULT_WORKER_TOKEN set on your worker instance
MEDIAVAULT_WORKER_TOKEN=your-secure-random-token-here

# ------------------------------------------------------------------------------
# 2. DOWNLOAD WORKER CONFIGURATION (Set in Docker / VPS / Railway / Render)
# ------------------------------------------------------------------------------
# Port for the standalone download worker HTTP/SSE server (Default: 4000)
PORT=4000
NODE_ENV=production

# Storage path for SQLite database, settings, and job logs
# In Docker: /app/data | On Host: ~/.mediavault
MEDIAVAULT_DATA_DIR=/app/data

# Destination directory where downloaded video, audio, and images are stored
# In Docker: /app/downloads | On Host: ~/Downloads/MediaVault
MEDIA_STORAGE_PATH=/app/downloads

# Optional explicit paths to CLI binaries (defaults to system PATH)
# YTDLP_PATH=yt-dlp
# SPOTDL_PATH=spotdl
# FFMPEG_PATH=ffmpeg
