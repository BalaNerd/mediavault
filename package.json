    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "common-tags": "^1.8.2",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.4.7",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.475.0",
    "next": "16.3.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sonner": "^2.0.1",
    "swr": "^2.3.2",
